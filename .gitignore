# ==========================================================
# LogWise .gitignore
# 目的：确保「密钥」和「本机环境文件」永远不会进入 Git 仓库
# 新增文件前，请先确认它不包含任何密码 / Key / 个人路径
# ==========================================================

# ---------- 1. 密钥与环境变量（最高优先级，绝对不能提交）----------
# .env 里存着真实的 DEEPSEEK_API_KEY，一旦推上 GitHub 会被爬虫秒抓
.env
.env.*
# 但 .env.example 是占位模板，必须提交，所以用 ! 单独放行
!.env.example

# ---------- 2. 本地虚拟环境（体积大，且写死了本机 Python 路径）----------
# 用 .venv*/ 而不是 .venv/ ，这样各种备份目录（如 .venv.broken.20260918）也会被一并忽略
.venv/
.venv*/
venv/
env/

# ---------- 3. Python 运行时产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---------- 4. IDE / 编辑器配置（含本机绝对路径、项目内元数据）----------
.idea/
.vscode/
*.iml
*.swp
*.swo

# ---------- 5. AI 助手工作目录（含本机路径与工作笔记）----------
.workbuddy/

# ---------- 6. 打包 / 构建产物 ----------
dist/
build/
*.egg

# ---------- 7. 操作系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 8. 临时文件 ----------
.tmp_*
*.tmp
*.bak

# ==========================================================
# 注意：data/ 目录下的 *.log 是项目自带的示例日志（演示用），
# 属于需要提交的内容，因此这里【不】忽略 *.log。
# 如果你以后在本地跑出真实业务日志，请放在 logs/ 目录下，
# 那个目录已被下面的规则忽略。
# ==========================================================
logs/
*.log.gz

# ==========================================================
# 向量索引与缓存：由 build_index.py 生成，可以随时重建，
# 而且里面是几十万个浮点数（约 1MB），没必要进版本库。
# 注意 data/fault_cases.jsonl 是知识库本体，那个【要】提交。
# ==========================================================
data/index/
