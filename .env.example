# ==========================================================
# LogWise 环境变量模板
# 复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 排除，不会被上传到 GitHub。
# ==========================================================

# ---------- DeepSeek 模型 ----------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 模型调用的超时与重试 ----------
# ⚠️ 必须显式设置。OpenAI SDK 的默认值是 read=600 秒 + max_retries=2，
#    最坏情况 600 ×（1 次原始 + 2 次重试）≈ 30 分钟挂住 ——
#    而实测一次诊断平均只要 2 秒。这个上限毫无意义，只会让故障时无法快速失败
#    （对 SSE 流式接口来说就是浏览器一直转圈）。
# 单次请求的读超时（秒）
LOGWISE_LLM_TIMEOUT=60
# 建连超时（秒）
LOGWISE_LLM_CONNECT_TIMEOUT=5
# SDK 层的网络重试次数（注意这不是「输出格式重试」，那个是本项目自己的逻辑，固定 1 次）
LOGWISE_LLM_MAX_RETRIES=1

# ---------- 输入上限与流式传输 ----------
# 单次请求允许粘贴的最大字符数（默认 200 万字符 ≈ 3.5 万行 / 2MB），超限返回 413。
# 上下文聚合只把最多 20 条日志送进模型，所以模型成本不随粘贴长度增长；
# 这个上限防的是「把整个日志文件拖进来」把解析线程和内存拖垮。0 = 不限制。
LOGWISE_MAX_LOG_CHARS=2000000
# /context 预览接口最多返回多少条日志（只影响展示，不影响实际送给模型的日志）
LOGWISE_MAX_CONTEXT_DISPLAY=500
# SSE 心跳间隔（秒）。一次 Agent 诊断最长十几秒，中途一个字节都没有，
# 部分网关会按空闲超时断开，前端只会看到「连接中断」。0 = 关闭心跳。
LOGWISE_SSE_HEARTBEAT=15

# ---------- 成本预算 ----------
# 每天允许花多少钱（元），0 = 不限制。
# 限流管的是「速率」，缓存管的是「重复」，都管不住「一天总共花了多少」——
# 默认 20 次/分钟最坏能跑两万多次/天。超预算后只有 /diagnose* 被拒绝，
# /context、/parse、/stats 仍然可用（否则超额后连统计都看不了）。
LOGWISE_DAILY_BUDGET_YUAN=5

# ---------- 接口鉴权 ----------
# 留空 = 关闭鉴权（适合本机演示，这是默认状态）
# 填上 = 所有业务接口都必须带请求头  X-API-Key: <值>  才能访问
LOGWISE_API_KEY=
# 开启鉴权后，来自本机回环地址(127.0.0.1)的请求仍然免 Key，
# 这样本地演示页不用做任何改动就能继续用。
# 注意：容器里外部请求的源 IP 是 Pod/节点 IP，不会是 127.0.0.1，所以不会被误放行。
LOGWISE_TRUST_LOCALHOST=true
# 仅在反向代理 / Ingress 后面才开启：采信 X-Forwarded-For 来识别真实客户端 IP。
# ⚠️ 服务直接暴露到公网时不要开启 —— 该请求头可以被客户端随意伪造，
#    一旦采信，限流和本机豁免都会失效。
LOGWISE_TRUST_PROXY_HEADERS=false

# ---------- 限流（按来源 IP 的令牌桶）----------
# 每个 IP 在窗口期内允许的请求数；设为 0 表示关闭限流
LOGWISE_RATE_LIMIT=20
LOGWISE_RATE_WINDOW=60

# ---------- 诊断结果缓存 ----------
# 同一段日志在 TTL 内不重复调用模型（缓存键含模型名与 Prompt 版本，
# 换模型或改 Prompt 后旧缓存自动失效）
LOGWISE_CACHE_ENABLED=true
LOGWISE_CACHE_TTL=3600
LOGWISE_CACHE_SIZE=500

# ---------- 日志上下文聚合 ----------
# 作用：决定把哪些日志送给模型。
# 关掉就退回旧行为（只取第一条 ERROR）—— 实测多日志故障场景命中率只有 16.7%，
# 开启后能接近 100%，所以除非要做 A/B 对比，否则建议保持开启。
LOGWISE_CONTEXT_ENABLED=true
# 位置窗口：以锚点（第一条 ERROR）为中心，前后各取几条日志
# 默认值 8 是参数扫描选出来的（评测集 38 条，其中 10 条专门区分参数）：
#   关闭聚合 → 上下文类命中率 10%     ±2/8 → 60%     ±4/12 → 80%     ±8/20 → 100%
# 四组输入 token 相差不到 5%，常规档全程 24/24，所以取最大值。
LOGWISE_CONTEXT_WINDOW=8
# 上下文包最多包含几条日志（防止粘贴几千行日志时输入 token 爆炸）
LOGWISE_CONTEXT_MAX_LOGS=20

# ---------- 历史故障案例检索（RAG）----------
# 每次诊断前先从 data/fault_cases.jsonl 里检索同类历史案例，注入 Prompt 作参考。
# 关掉后行为与没有这个功能时完全一致。
LOGWISE_RAG_ENABLED=true
# 注入策略：
#   fixed   = 只用 app/prompts.py 里固定的 4 个示例（基线）
#   dynamic = 只用检索到的历史案例
#   hybrid  = 固定示例 + 检索案例
# 三组的实测对比（准确率 / 幻觉 / 置信度校准 / 成本）见 docs/EXPERIMENTS.md 第 5 节。
LOGWISE_RAG_MODE=fixed
# 每次检索注入几条案例（上限 10）
LOGWISE_RAG_TOP_K=3

# ---------- 向量化服务（可选，用于 Dense / Hybrid 检索）----------
# 诊断用 DeepSeek，向量化需要另一家 —— DeepSeek 实测不提供 embedding 接口
# （POST /embeddings 返回 404，模型列表只有对话模型）。
# 下面是 OpenAI 兼容格式，智谱 / 阿里百炼 / 硅基流动 都适用：
# 换厂商只改这三行，代码不用动。
#
# ⚠️ 不填也能正常用：服务会自动降级到 BM25 词法检索，只是没有向量检索能力。
#
# 智谱开放平台 https://bigmodel.cn  →  base_url 见下
# embedding-3 定价 0.5 元/百万 token；53 条知识库建索引约 0.005 元。
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-3
# 向量维度，留空用服务端默认值（embedding-3 支持 256~2048，设 1024 可省一半存储）
EMBEDDING_DIMENSIONS=
# 建索引脚本用于估算花费的单价（元/百万 token），请与官方定价页核对
EMBEDDING_PRICE_PER_MILLION=0.5

# ---------- 检索后端 ----------
#   bm25   = 词法检索（默认；纯本地、零依赖、零成本）
#   dense  = 向量检索（需上面的 EMBEDDING_API_KEY + 先跑 python build_index.py）
#   hybrid = 两者用 RRF 融合
LOGWISE_RETRIEVER_BACKEND=bm25
#
# 选择优先级：锚点 > 窗口内的异常日志 > 窗口内的普通日志 > 窗口外的异常日志。
# 窗口外的纯 INFO/DEBUG 不会被纳入。
# 改动上面任一参数都会让诊断缓存自动失效（参数已纳入缓存键）。

# ---------- 成本统计单价（元 / 百万 token，共三档）----------
# ⚠️ DeepSeek 调价频繁，且区分高峰/空闲时段。请到官方定价页核对后修改：
#    https://api-docs.deepseek.com/quick_start/pricing
#
# 为什么要三档：DeepSeek 会自动缓存「重复出现的 Prompt 前缀」。
# 我们每次请求的 System Prompt + Few-shot 完全一致，正好命中缓存，
# 这部分输入 token 的单价远低于未命中的。不分开算的话成本会明显高估。
#
# 输入 · 缓存命中（本项目实测约 70% 的输入 token 走这一档）
DEEPSEEK_PRICE_INPUT_CACHED=0.2
# 输入 · 缓存未命中
DEEPSEEK_PRICE_INPUT=1.0
# 输出
DEEPSEEK_PRICE_OUTPUT=2.0
#
# GET /stats 会回显当前实际使用的三档单价，方便你判断配置有没有过时。